{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "*.test.mjs"],
      "predeploy": ["node \"$PROJECT_DIR/tools/copy-shared.mjs\""]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.indexes.json", "**/.*", "**/node_modules/**", "functions/**", "test/**", "tools/**",
      "README.md", "package.json", "package-lock.json", "firestore.rules", "*.log"
    ],
    "rewrites": [
      { "source": "/calendar.ics", "function": { "functionId": "calendar", "region": "europe-west2" } }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
      { "source": "/@(index.html|sw.js|manifest.json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
